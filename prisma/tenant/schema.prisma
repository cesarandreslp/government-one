// Schema del TENANT (fundación de dominio). Cada tenant tiene su propia BD Neon con
// ESTE schema. Aparte de la meta-DB (prisma/schema.prisma).
// Núcleo: estructura organizacional + cargos + vínculos persona↔cargo. Los módulos
// (contratación, presupuesto, …) se agregan encima en fases posteriores.
// Prisma 7: la URL de conexión NO va aquí; el cliente se crea con adapter por-tenant
// (ver src/lib/tenant-db.ts) y las migraciones se aplican por-tenant.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/tenant"
}

datasource db {
  provider = "postgresql"
}

// ─── Identidad de plataforma (el rol NO modela funciones; eso son capacidades vía cargo) ───
enum RolUsuario {
  SUPER_ADMIN // admin máximo de la entidad
  ADMIN
  USER // funcionario genérico
  CONTRATISTA // identidad externa (portal), no ocupa cargo
}

enum DependenciaTipo {
  DESPACHO
  SECRETARIA
  SUBSECRETARIA
  DIRECCION
  OFICINA
}

enum VinculacionTipo {
  TITULAR
  ENCARGADO // cubre ausencias temporales
  PROVISIONAL // por resolución/decreto hasta concurso de méritos
}

/// Nivel del cargo (Decreto-Ley 785/2005: clasificación de empleos públicos). Null en cargos de
/// elección/período fijo (Alcalde, Personero) que no se clasifican en la escala de carrera.
enum NivelCargo {
  ASISTENCIAL
  TECNICO
  PROFESIONAL
  ASESOR
  DIRECTIVO
}

enum AusenciaTipo {
  VACACIONES
  LICENCIA
  COMISION
  INCAPACIDAD
}

/// Catálogo NACIONAL de empleos (Decreto 785/2005: nomenclatura y clasificación de empleos para
/// entidades territoriales) — sembrado en la BD del tenant (mismo patrón que CGC/CCPET: catálogo
/// nacional, editable una vez sembrado). `nivel` en `Cargo` se DERIVA de este catálogo, no se
/// elige manualmente.
model EmpleoDafp {
  id           String     @id @default(cuid())
  codigo       String     @unique // ej. "222-02" (código DAFP + grado)
  denominacion String // ej. "Profesional Especializado Grado 2"
  nivel        NivelCargo
  activo       Boolean    @default(true)

  cargos Cargo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("empleos_dafp")
}

/// Árbol organizacional: Secretaría → Subsecretaría → Dirección → Oficina (profundidad libre).
model Dependencia {
  id          String          @id @default(cuid())
  codigo      String          @unique
  nombre      String
  tipo        DependenciaTipo @default(SECRETARIA)
  /// Servicio compartido/transversal (Jurídica, Contratación) que sirve a TODAS las dependencias.
  esServicioCompartido Boolean @default(false)
  activa      Boolean         @default(true)
  /// Módulos ASIGNADOS a esta dependencia por el admin del tenant (array de moduloId). Un
  /// funcionario solo opera un módulo si está asignado a su dependencia. Ver src/lib/modulos.ts.
  modulos     Json            @default("[]")

  // Jerarquía
  padreId String?
  padre   Dependencia?  @relation("SubDependencias", fields: [padreId], references: [id])
  hijas   Dependencia[] @relation("SubDependencias")

  cargos    Cargo[]
  gdSeries  GdSerie[]
  radicados Radicado[]
  pqrsds    Pqrsd[]
  proyectos Proyecto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([padreId])
  @@map("dependencias")
}

/// Cargo (posición) dentro de una dependencia. Confiere un bundle de capacidades.
/// La asignación de trabajo va al CARGO; se resuelve a quien lo ejerce hoy.
model Cargo {
  id            String      @id @default(cuid())
  dependenciaId String
  dependencia   Dependencia @relation(fields: [dependenciaId], references: [id])
  nombre        String
  /// ¿Es el cargo cabeza de la dependencia? (fallback de ruteo/aprobación).
  esJefatura    Boolean     @default(false)
  /// Nivel del empleo (asistencial/técnico/profesional/asesor/directivo). DERIVADO de `empleo` al
  /// asignarlo (no se elige a mano). Null = cargo de elección/período fijo (Alcalde, Personero).
  nivel         NivelCargo?
  /// Denominación DAFP del empleo (catálogo `EmpleoDafp`). Null = cargo de elección/período fijo.
  empleoId      String?
  empleo        EmpleoDafp? @relation(fields: [empleoId], references: [id])
  /// Funciones/responsabilidad ESPECÍFICA de este cargo (manual de funciones), ej. "Estratificación
  /// socioeconómica municipal". Distinto de `grants`: esto es descriptivo, no confiere autoridad.
  funciones     String?
  /// Jefe inmediato DENTRO de la dependencia (supervisión real, distinta de `esJefatura` de la
  /// dependencia completa — ej. un profesional líder de equipo sin ser el secretario de despacho).
  jefeInmediatoId String?
  jefeInmediato    Cargo?  @relation("CargoSupervision", fields: [jefeInmediatoId], references: [id])
  subalternos      Cargo[] @relation("CargoSupervision")
  /// Bundle de capacidades: { moduloId: capacidad[] }. Mismo formato que los grants por usuario.
  grants        Json        @default("{}")
  activo        Boolean     @default(true)

  vinculaciones VinculacionCargo[]
  pqrsds        Pqrsd[]
  sstRiesgos    SstRiesgoCargo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dependenciaId])
  @@index([empleoId])
  @@index([jefeInmediatoId])
  @@map("cargos")
}

/// Funcionario (persona) de la entidad. Identidad; las funciones vienen de sus cargos.
model Usuario {
  id       String     @id @default(cuid())
  email    String     @unique
  nombre   String
  apellido String
  rol      RolUsuario @default(USER)
  activo   Boolean    @default(true)
  /// Hash bcrypt de la contraseña del funcionario. Null = sin acceso (aún no se le fijó clave).
  /// Nunca se expone al cliente; la verificación compara en el servidor (ver tenant-auth.ts).
  passwordHash String?

  // Identidad y seguridad social — RRHH los captura; Nómina los usa para PILA/certificados.
  documento      String?        @unique
  tipoDocumento  TipoDocumento?
  codigoEps      String?
  codigoAfp      String?
  codigoArl      String?
  /// Clase de riesgo ARL (1..5, Decreto 1772/1994). Null = se asume clase I (administrativo).
  claseRiesgoArl Int?
  codigoCaja     String?

  vinculaciones    VinculacionCargo[]
  ausencias        Ausencia[]
  radicados        Radicado[]
  pqrsdAsignadas   Pqrsd[]            @relation("PqrsdAsignada")
  pqrsdRespondidas Pqrsd[]            @relation("PqrsdRespondida")
  contratosEstructurados Contrato[]   @relation("ContratoEstructurador")
  contratosRevisados     Contrato[]   @relation("ContratoAbogado")
  liquidacionesNomina    LiquidacionNomina[]
  evaluacionesRecibidas  EvaluacionDesempeno[] @relation("EvaluacionEvaluado")
  evaluacionesRealizadas EvaluacionDesempeno[] @relation("EvaluacionEvaluador")
  sstIncidentes             SstIncidente[]
  sstExamenes               SstExamenMedico[]
  capacitacionInscripciones CapacitacionInscripcion[]
  bienestarParticipaciones  BienestarParticipante[]
  permisosSindicales        PermisoSindical[]
  procesosDisciplinarios    ProcesoDisciplinario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

/// Vínculo persona↔cargo. Una persona puede tener VARIOS vigentes (titular + encargos).
/// desde/hasta dan el snapshot histórico (auditoría: quién ejercía qué en el momento T).
model VinculacionCargo {
  id        String          @id @default(cuid())
  usuarioId String
  usuario   Usuario         @relation(fields: [usuarioId], references: [id])
  cargoId   String
  cargo     Cargo           @relation(fields: [cargoId], references: [id])
  tipo      VinculacionTipo @default(TITULAR)
  /// Acto administrativo (resolución/decreto) que soporta el nombramiento (encargo/provisional).
  actoAdmin String?
  /// Asignación salarial de ESTE vínculo (la fija RRHH al posesionar). Null = aún sin fijar —
  /// Nómina no puede liquidar a quien no tiene salario asignado en ninguna vinculación vigente.
  salarioBasico Decimal? @db.Decimal(18, 2)
  desde     DateTime        @default(now())
  hasta     DateTime? // null = vigente

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([cargoId])
  @@map("vinculaciones_cargo")
}

/// Ausencia (vacaciones/licencia/…) — explica el hueco que llena un encargo (enriquecimiento RRHH).
model Ausencia {
  id        String       @id @default(cuid())
  usuarioId String
  usuario   Usuario      @relation(fields: [usuarioId], references: [id])
  tipo      AusenciaTipo
  desde     DateTime
  hasta     DateTime
  motivo    String?

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("ausencias")
}

// ─────────────────── Módulo base: GESTIÓN DOCUMENTAL (TRD + radicación) ───────────────────
// La Tabla de Retención Documental (TRD) es DATO del tenant (cada entidad aprueba la suya),
// no un catálogo nacional: Serie → Subserie por dependencia, con tiempos y disposición final.
// El radicado numera con consecutivo POR TENANT (por tipo y año), atómico.

enum GdTipoRadicado {
  ENTRADA // documento que llega del exterior
  SALIDA // documento que la entidad envía
  INTERNO // memorando/comunicación interna
}

enum GdEstadoRadicado {
  RADICADO
  EN_TRAMITE
  RESPONDIDO
  ARCHIVADO
  ANULADO
}

/// Disposición final de la subserie documental (norma AGN).
enum GdDisposicion {
  CONSERVACION_TOTAL
  ELIMINACION
  SELECCION
  DIGITALIZACION
}

/// Serie documental de la TRD, asociada a una dependencia productora.
model GdSerie {
  id            String      @id @default(cuid())
  dependenciaId String
  dependencia   Dependencia @relation(fields: [dependenciaId], references: [id])
  codigo        String
  nombre        String
  activa        Boolean     @default(true)

  subseries GdSubserie[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dependenciaId, codigo])
  @@index([dependenciaId])
  @@map("gd_series")
}

/// Subserie documental: nivel donde viven la retención y la disposición final.
model GdSubserie {
  id               String         @id @default(cuid())
  serieId          String
  serie            GdSerie        @relation(fields: [serieId], references: [id], onDelete: Cascade)
  codigo           String
  nombre           String
  retencionGestion Int? // años en archivo de gestión
  retencionCentral Int? // años en archivo central
  disposicion      GdDisposicion?
  activa           Boolean        @default(true)

  radicados Radicado[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serieId, codigo])
  @@index([serieId])
  @@map("gd_subseries")
}

/// Contador atómico del consecutivo de radicación, por tipo y año (numeración por tenant).
model GdConsecutivo {
  id     String         @id @default(cuid())
  tipo   GdTipoRadicado
  anio   Int
  ultimo Int            @default(0)

  @@unique([tipo, anio])
  @@map("gd_consecutivos")
}

/// Radicado: registro de entrada/salida/interno con número consecutivo único por tenant.
model Radicado {
  id          String           @id @default(cuid())
  numero      String           @unique // ej. E-2026-000001
  tipo        GdTipoRadicado
  anio        Int
  consecutivo Int
  asunto      String
  /// Remitente (ENTRADA) o destinatario (SALIDA); tercero externo, texto libre.
  tercero     String?
  estado      GdEstadoRadicado @default(RADICADO)

  // Ruteo a la dependencia responsable + clasificación TRD (opcional al radicar).
  dependenciaId String?
  dependencia   Dependencia? @relation(fields: [dependenciaId], references: [id])
  subserieId    String?
  subserie      GdSubserie?  @relation(fields: [subserieId], references: [id])

  radicadoPorId String?
  radicadoPor   Usuario? @relation(fields: [radicadoPorId], references: [id])

  fechaRadicado DateTime    @default(now())
  adjuntos      GdAdjunto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipo, anio])
  @@index([dependenciaId])
  @@index([estado])
  @@map("radicados")
}

/// Adjunto de un radicado. El storage por-tenant llega después; por ahora referencia por URL.
model GdAdjunto {
  id         String   @id @default(cuid())
  radicadoId String
  radicado   Radicado @relation(fields: [radicadoId], references: [id], onDelete: Cascade)
  nombre     String
  url        String
  createdAt  DateTime @default(now())

  @@index([radicadoId])
  @@map("gd_adjuntos")
}

// ───────────────────── Módulo base: VENTANILLA ÚNICA (PQRSD) ─────────────────────
// La PQRSD entra y se asigna AUTOMÁTICAMENTE al funcionario que EJERCE el cargo competente
// (fundación de dominio: quienEjerce → encargado/titular sin ausencia → fallback). El acceso a
// las acciones es por CAPACIDAD ventanilla_unica (no por rol). Numeración por tenant/año.

enum PqrsdTipo {
  PETICION
  QUEJA
  RECLAMO
  SUGERENCIA
  DENUNCIA
}

enum PqrsdCanal {
  WEB
  PRESENCIAL
  TELEFONICO
  EMAIL
  ESCRITO
}

enum PqrsdEstado {
  RECIBIDA // sin asignar (nadie ejerce el cargo competente)
  ASIGNADA // asignada al funcionario que ejerce el cargo
  EN_TRAMITE
  RESPONDIDA
  CERRADA
}

/// Contador atómico del consecutivo de PQRSD, por año (numeración por tenant).
model PqrsdConsecutivo {
  id     String @id @default(cuid())
  anio   Int    @unique
  ultimo Int    @default(0)

  @@map("pqrsd_consecutivos")
}

/// Petición/Queja/Reclamo/Sugerencia/Denuncia ciudadana, con ruteo por cargo y término de ley.
model Pqrsd {
  id          String      @id @default(cuid())
  numero      String      @unique // ej. PQRSD-2026-000001
  anio        Int
  consecutivo Int
  tipo        PqrsdTipo
  canal       PqrsdCanal  @default(PRESENCIAL)
  estado      PqrsdEstado @default(RECIBIDA)

  // Peticionario (ciudadano)
  peticionarioNombre   String
  peticionarioEmail    String?
  peticionarioTelefono String?
  asunto               String
  descripcion          String

  // Ruteo por cargo (fundación de dominio): dependencia competente → cargo → quien lo ejerce hoy.
  dependenciaId     String?
  dependencia       Dependencia? @relation(fields: [dependenciaId], references: [id])
  cargoAsignadoId   String?
  cargoAsignado     Cargo?       @relation(fields: [cargoAsignadoId], references: [id])
  usuarioAsignadoId String?
  usuarioAsignado   Usuario?     @relation("PqrsdAsignada", fields: [usuarioAsignadoId], references: [id])

  // Términos de ley (días hábiles).
  fechaRecepcion   DateTime @default(now())
  diasTermino      Int
  fechaVencimiento DateTime

  // Respuesta
  respuesta       String?
  fechaRespuesta  DateTime?
  respondidoPorId String?
  respondidoPor   Usuario?  @relation("PqrsdRespondida", fields: [respondidoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([usuarioAsignadoId])
  @@index([dependenciaId])
  @@map("pqrsd")
}

// ───────────────────── Módulo: CONTABILIDAD (libro mayor, doble partida) ─────────────────────
// El plan de cuentas (CGC — Catálogo General de Cuentas, Res. CGN 533/2015 para entidades de
// gobierno) es CATÁLOGO NACIONAL (primitivo de plataforma, como CCPET/Res.1519): se siembra por
// tenant, editable. El motor es doble partida estricta: ∑débitos = ∑créditos por comprobante.

enum Naturaleza {
  DEBITO
  CREDITO
}

enum TipoCuenta {
  BALANCE // activo / pasivo / patrimonio
  RESULTADO // ingreso / gasto
  ORDEN // cuentas de orden / control
}

enum EstadoPeriodo {
  ABIERTO
  CERRADO
  AJUSTE // solo administración puede registrar
}

enum TipoComprobante {
  CONTABLE
  EGRESO
  INGRESO
  AJUSTE
  APERTURA
  CIERRE
}

enum EstadoComprobante {
  REGISTRADO
  ANULADO
}

enum TipoDocumento {
  NIT
  CC
  CE
  PA
  OTRO
}

/// Plan de cuentas (CGC), jerárquico. Solo las hojas (`permiteMovimientos`) reciben asientos.
model PlanCuenta {
  id                 String       @id @default(cuid())
  codigo             String       @unique // ej. "1110", "111005"
  nombre             String
  nivel              Int // 1=clase 2=grupo 3=cuenta 4=subcuenta
  naturaleza         Naturaleza
  tipo               TipoCuenta
  activa             Boolean      @default(true)
  permiteMovimientos Boolean      @default(false)

  parentId String?
  parent   PlanCuenta?  @relation("CuentaJerarquia", fields: [parentId], references: [id])
  hijos    PlanCuenta[] @relation("CuentaJerarquia")
  asientos Asiento[]
  cuentasTesoreria TesoCuenta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([nivel])
  @@map("cp_plan_cuentas")
}

/// Periodo contable (mensual o anual). Los comprobantes se registran contra un periodo ABIERTO.
model PeriodoContable {
  id          String        @id @default(cuid())
  codigo      String        @unique // "2026-05" o "2026"
  anio        Int
  mes         Int? // 1..12, null = anual
  estado      EstadoPeriodo @default(ABIERTO)
  fechaInicio DateTime
  fechaFin    DateTime
  cerradoEn   DateTime?
  cerradoPor  String?

  comprobantes Comprobante[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([anio, mes])
  @@map("cp_periodos")
}

/// Tercero auxiliar (NIT/CC): proveedor, contratista, beneficiario. Registro compartido.
model Tercero {
  id            String        @id @default(cuid())
  documento     String        @unique
  tipoDocumento TipoDocumento @default(NIT)
  razonSocial   String
  email         String?
  telefono      String?
  activo        Boolean       @default(true)

  asientos  Asiento[]
  rps       Rp[]
  contratos Contrato[]
  rentaPredios         RentaPredio[]
  rentaEstablecimientos RentaEstablecimiento[]
  procesosCoactivo     CoactivoProceso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([razonSocial])
  @@map("cp_terceros")
}

/// Contador atómico del consecutivo de comprobantes, por tipo y año.
model ComprobanteConsecutivo {
  id     String          @id @default(cuid())
  tipo   TipoComprobante
  anio   Int
  ultimo Int             @default(0)

  @@unique([tipo, anio])
  @@map("cp_consecutivos")
}

/// Comprobante contable (encabezado). Agrupa N asientos que cuadran (∑D = ∑C).
model Comprobante {
  id           String            @id @default(cuid())
  numero       String            @unique // "CC-2026-000123"
  tipo         TipoComprobante   @default(CONTABLE)
  fecha        DateTime
  descripcion  String
  estado       EstadoComprobante @default(REGISTRADO)
  periodoId    String
  periodo      PeriodoContable   @relation(fields: [periodoId], references: [id])
  anio         Int
  consecutivo  Int
  totalDebito  Decimal           @db.Decimal(18, 2)
  totalCredito Decimal           @db.Decimal(18, 2)

  asientos Asiento[]
  pago     Pago?
  liquidacionesNomina LiquidacionNomina[]
  pagosPasivosNomina  NominaPagoPasivo[]
  pagoRenta           RentaPago?
  pagoCuotaCoactivo   CoactivoCuota?

  // Trazabilidad cruzada (presupuesto/nómina/… postean aquí).
  fuenteModulo    String?
  fuenteRef       String?
  creadoPor       String?
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodoId])
  @@index([fecha])
  @@index([fuenteModulo, fuenteRef])
  @@map("cp_comprobantes")
}

/// Asiento (línea de débito o crédito de un comprobante).
model Asiento {
  id            String      @id @default(cuid())
  comprobanteId String
  comprobante   Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  cuentaId      String
  cuenta        PlanCuenta  @relation(fields: [cuentaId], references: [id])
  terceroId     String?
  tercero       Tercero?    @relation(fields: [terceroId], references: [id])
  debito        Decimal     @default(0) @db.Decimal(18, 2)
  credito       Decimal     @default(0) @db.Decimal(18, 2)
  descripcion   String?
  tesoConciliacion TesoConciliacion?

  createdAt DateTime @default(now())

  @@index([comprobanteId])
  @@index([cuentaId])
  @@index([terceroId])
  @@map("cp_asientos")
}

// ───────────────────── Módulo: PRESUPUESTO (CDP → RP → Obligación → Pago) ─────────────────────
// El catálogo de clasificación (CCPET — Catálogo de Clasificación Presupuestal para Entidades
// Territoriales, MinHacienda) es CATÁLOGO NACIONAL (primitivo de plataforma, paralelo al CGC de
// Contabilidad — clasifica EN QUÉ se gasta/de dónde viene el ingreso, no el libro mayor). Este
// primer corte cubre Rubro + Apropiación (vigencia) + CDP (Certificado de Disponibilidad
// Presupuestal) con validación de saldo disponible; RP/Obligación/Pago quedan para el siguiente
// incremento del mismo módulo.

enum RubroTipo {
  INGRESO
  GASTO
}

enum EstadoDocPresupuestal {
  VIGENTE
  ANULADO
}

/// Rubro presupuestal (CCPET), jerárquico. Solo las hojas (`permiteMovimientos`) reciben CDP.
model RubroPresupuestal {
  id                 String    @id @default(cuid())
  codigo             String    @unique // ej. "2.3.1.01.01" (CCPET, hasta 10 niveles)
  nombre             String
  tipo               RubroTipo
  nivel              Int
  permiteMovimientos Boolean   @default(false)
  activo             Boolean   @default(true)

  parentId String?
  parent   RubroPresupuestal?  @relation("RubroJerarquia", fields: [parentId], references: [id])
  hijos    RubroPresupuestal[] @relation("RubroJerarquia")

  apropiaciones Apropiacion[]
  cdps          Cdp[]
  liquidacionesRenta RentaLiquidacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([tipo])
  @@map("psp_rubros")
}

/// Apropiación presupuestal de un rubro de GASTO para una vigencia (año fiscal). El disponible
/// se calcula al vuelo: (inicial + adiciones - reducciones) - Σ CDP vigentes del rubro/vigencia.
model Apropiacion {
  id                 String            @id @default(cuid())
  rubroId            String
  rubro              RubroPresupuestal @relation(fields: [rubroId], references: [id])
  vigencia           Int
  apropiacionInicial Decimal           @db.Decimal(18, 2)
  adiciones          Decimal           @default(0) @db.Decimal(18, 2)
  reducciones        Decimal           @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rubroId, vigencia])
  @@map("psp_apropiaciones")
}

/// Contador atómico del consecutivo de CDP, por vigencia.
model CdpConsecutivo {
  id       String @id @default(cuid())
  vigencia Int    @unique
  ultimo   Int    @default(0)

  @@map("psp_cdp_consecutivos")
}

/// CDP (Certificado de Disponibilidad Presupuestal) — reserva presupuestal previa a comprometer
/// el gasto. Valida `valor ≤ disponible` de la apropiación del rubro/vigencia al crearse.
model Cdp {
  id       String                @id @default(cuid())
  numero   String                @unique // "CDP-2026-000123"
  fecha    DateTime
  vigencia Int
  rubroId  String
  rubro    RubroPresupuestal     @relation(fields: [rubroId], references: [id])
  valor    Decimal               @db.Decimal(18, 2)
  objeto   String
  estado   EstadoDocPresupuestal @default(VIGENTE)

  proyectoId String?
  proyecto   Proyecto? @relation(fields: [proyectoId], references: [id])

  creadoPor       String?
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rps Rp[]

  @@index([proyectoId])

  @@index([rubroId, vigencia])
  @@index([vigencia])
  @@map("psp_cdps")
}

/// Contador atómico del consecutivo de RP, por vigencia.
model RpConsecutivo {
  id       String @id @default(cuid())
  vigencia Int    @unique
  ultimo   Int    @default(0)

  @@map("psp_rp_consecutivos")
}

/// RP (Registro Presupuestal de Compromiso) — afecta un CDP; formaliza el compromiso con un
/// tercero. Valida `valor ≤ disponible` del CDP (CDP.valor − Σ RP vigentes) al crearse.
model Rp {
  id        String                @id @default(cuid())
  numero    String                @unique // "RP-2026-000123"
  fecha     DateTime
  vigencia  Int
  cdpId     String
  cdp       Cdp                   @relation(fields: [cdpId], references: [id])
  terceroId String?
  tercero   Tercero?              @relation(fields: [terceroId], references: [id])
  valor     Decimal               @db.Decimal(18, 2)
  objeto    String
  estado    EstadoDocPresupuestal @default(VIGENTE)

  creadoPor       String?
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  obligaciones Obligacion[]
  contratos    Contrato[]

  @@index([cdpId])
  @@map("psp_rps")
}

/// Contador atómico del consecutivo de Obligación, por vigencia.
model ObligacionConsecutivo {
  id       String @id @default(cuid())
  vigencia Int    @unique
  ultimo   Int    @default(0)

  @@map("psp_obligacion_consecutivos")
}

/// Obligación (cuenta por pagar) — afecta un RP; el bien/servicio ya se recibió a satisfacción.
/// Valida `valor ≤ disponible` del RP (RP.valor − Σ Obligación vigentes) al crearse.
model Obligacion {
  id       String                @id @default(cuid())
  numero   String                @unique // "OB-2026-000123"
  fecha    DateTime
  rpId     String
  rp       Rp                    @relation(fields: [rpId], references: [id])
  valor    Decimal               @db.Decimal(18, 2)
  concepto String
  estado   EstadoDocPresupuestal @default(VIGENTE)

  creadoPor       String?
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pagos Pago[]

  @@index([rpId])
  @@map("psp_obligaciones")
}

enum MedioPago {
  TRANSFERENCIA
  CHEQUE
  EFECTIVO
  OTRO
}

/// Contador atómico del consecutivo de Pago, por vigencia.
model PagoConsecutivo {
  id       String @id @default(cuid())
  vigencia Int    @unique
  ultimo   Int    @default(0)

  @@map("psp_pago_consecutivos")
}

/// Pago — afecta una Obligación; cierra la cadena presupuestal Y contable en una sola
/// transacción: genera un Comprobante EGRESO (D gasto / C banco) en Contabilidad. Valida
/// `valor ≤ disponible` de la Obligación (Obligacion.valor − Σ Pago vigentes) al crearse.
model Pago {
  id           String                @id @default(cuid())
  numero       String                @unique // "PG-2026-000123"
  fecha        DateTime
  obligacionId String
  obligacion   Obligacion            @relation(fields: [obligacionId], references: [id])
  valor        Decimal               @db.Decimal(18, 2)
  medioPago    MedioPago             @default(TRANSFERENCIA)
  referencia   String?
  comprobanteId String               @unique
  comprobante  Comprobante           @relation(fields: [comprobanteId], references: [id])
  estado       EstadoDocPresupuestal @default(VIGENTE)

  creadoPor       String?
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([obligacionId])
  @@map("psp_pagos")
}

// ───────────────────── Módulo: BANCO DE PROYECTOS (financiera vs. física) ─────────────────────
// El diferenciador: ejecución FINANCIERA (derivada de CDP→RP→Obligación→Pago con proyectoId) vs.
// ejecución FÍSICA (independiente del dinero, por hitos ponderados reportados por el supervisor).
// La BRECHA entre ambas es la señal de riesgo (ej. anticipo pagado 50%/obra en campo 0%).
// Sin Contratación todavía (viene después en el orden) — la física se reporta por hito directo
// del proyecto, no por actividad de contrato; se revisará cuando exista Contratación.

enum ProyectoEstado {
  FORMULACION
  EJECUCION
  SUSPENDIDO
  CERRADO
}

/// Contador atómico del consecutivo de proyectos, por vigencia.
model ProyectoConsecutivo {
  id       String @id @default(cuid())
  vigencia Int    @unique
  ultimo   Int    @default(0)

  @@map("bp_proyecto_consecutivos")
}

model Proyecto {
  id            String         @id @default(cuid())
  codigo        String         @unique // "PRY-2026-001"
  nombre        String
  descripcion   String?
  vigencia      Int
  dependenciaId String
  dependencia   Dependencia    @relation(fields: [dependenciaId], references: [id])
  estado        ProyectoEstado @default(FORMULACION)
  valorTotal    Decimal?       @db.Decimal(18, 2) // presupuesto total planeado (informativo)

  fechaInicio      DateTime?
  fechaFinPrevista DateTime?
  creadoPor        String?

  hitos ProyectoHito[]
  cdps  Cdp[] // la ejecución financiera (y, transitivamente, los contratos vía Cdp→Rp→Contrato) cuelga de aquí

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dependenciaId])
  @@index([vigencia])
  @@map("bp_proyectos")
}

/// Hito del proyecto — unidad de avance FÍSICO, ponderado (Σ pesoPorcentual tiende a 100).
model ProyectoHito {
  id               String   @id @default(cuid())
  proyectoId       String
  proyecto         Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre           String
  descripcion      String?
  pesoPorcentual   Decimal  @db.Decimal(5, 2)
  avancePorcentual Decimal  @default(0) @db.Decimal(5, 2)

  fechaProgramada DateTime?
  // Snapshot del ÚLTIMO reporte (lectura rápida). El histórico auditable vive en los reportes.
  fechaReporte    DateTime?
  reportadoPor    String?
  evidenciaUrl    String?
  observacion     String?

  reportes ProyectoHitoReporte[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proyectoId])
  @@map("bp_proyecto_hitos")
}

/// Histórico auditable de reportes de avance físico — quién reportó qué, cuándo, con qué
/// evidencia. Insert-only (no se edita ni se borra), trazabilidad ante entes de control.
model ProyectoHitoReporte {
  id           String       @id @default(cuid())
  hitoId       String
  hito         ProyectoHito @relation(fields: [hitoId], references: [id], onDelete: Cascade)
  avancePorcentual Decimal  @db.Decimal(5, 2)
  evidenciaUrl String?
  observacion  String?
  reportadoPor String?

  createdAt DateTime @default(now())

  @@index([hitoId])
  @@map("bp_proyecto_hito_reportes")
}

// ───────────────────── Módulo: CONTRATACIÓN (Ley 80/1150) ─────────────────────
// Máquina de estados con GATING REAL POR PERSONA, no solo por capacidad: la capacidad
// (contratacion: elaborar/revisar_juridica/concepto_juridico/supervisar/aprobar, ya en el
// catálogo desde la fundación) dice qué TIPO de acción puede hacer alguien; la asignación
// (estructuradorId/abogadoAsignadoId) dice si es la persona correcta PARA ESTE contrato — las
// dos condiciones se exigen juntas (ver src/lib/contratacion/flujo.ts). Portado de personeriabuga
// (hallazgo explícito: sin el segundo chequeo, cualquiera con la capacidad podía aprobar su
// propio contrato como si fuera otro actor de la cadena).

enum ModalidadContratacion {
  LICITACION_PUBLICA
  SELECCION_ABREVIADA
  CONCURSO_MERITOS
  CONTRATACION_DIRECTA
  MINIMA_CUANTIA
}

enum EstadoContrato {
  BORRADOR
  EN_REVISION_JURIDICA
  DEVUELTO_ESTRUCTURACION
  PERFECCIONADO
  RP_REGISTRADO
  SUSCRITO
  EN_EJECUCION
  SUSPENDIDO
  TERMINADO
  INCUMPLIDO
  LIQUIDADO
}

enum TipoVersionContrato {
  BORRADOR_ESTRUCTURACION
  REVISION_JURIDICA
}

/// Contador atómico del consecutivo de contratos, por vigencia.
model ContratoConsecutivo {
  id       String @id @default(cuid())
  vigencia Int    @unique
  ultimo   Int    @default(0)

  @@map("con_consecutivos")
}

model Contrato {
  id            String                @id @default(cuid())
  numero        String                @unique // "C-2026-001"
  vigencia      Int
  objeto        String
  modalidad     ModalidadContratacion
  valorContrato Decimal               @db.Decimal(18, 2)
  plazoDias     Int?
  estado        EstadoContrato        @default(BORRADOR)

  terceroId String // contratista
  tercero   Tercero @relation(fields: [terceroId], references: [id])

  estructuradorId   String?
  estructurador     Usuario? @relation("ContratoEstructurador", fields: [estructuradorId], references: [id])
  abogadoAsignadoId String?
  abogadoAsignado   Usuario? @relation("ContratoAbogado", fields: [abogadoAsignadoId], references: [id])

  // Sin proyectoId propio a propósito: el proyecto (si el contrato financia uno) se deriva
  // SIEMPRE de Contrato → Rp → Cdp → Proyecto — esa cadena es la que ya alimenta el seguimiento
  // financiero real (ejecucionProyecto). Un campo separado aquí podría desalinearse del RP real
  // y romper el seguimiento sin que nadie lo note.
  rpId String? // obligatorio en la práctica desde RP_REGISTRADO en adelante (ver flujo.ts)
  rp   Rp?     @relation(fields: [rpId], references: [id])

  fechaSuscripcion DateTime?
  creadoPor        String?

  versiones ContratoVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([terceroId])
  @@index([vigencia])
  @@index([estructuradorId])
  @@index([abogadoAsignadoId])
  @@map("con_contratos")
}

/// Versión insert-only del contenido/revisión — cada borrador de estructuración y cada
/// respuesta de jurídica queda versionada, nunca se sobreescribe.
model ContratoVersion {
  id            String              @id @default(cuid())
  contratoId    String
  contrato      Contrato            @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numeroVersion Int
  tipo          TipoVersionContrato
  contenido     String?
  aprobado      Boolean?
  observaciones String?
  autorId       String?

  createdAt DateTime @default(now())

  @@index([contratoId])
  @@map("con_contrato_versiones")
}

// ───────────────────── Módulo: NÓMINA (liquidación → posteo a Contabilidad) ─────────────────────
// El "empleado de nómina" NO es un modelo aparte: es un `Usuario` con `VinculacionCargo` vigente
// que RRHH ya registró (Paso 2) — nómina solo LEE el salario que RRHH fijó al posesionar
// (`VinculacionCargo.salarioBasico`), nunca duplica identidad ni estructura. Los conceptos
// (`ConceptoNomina`) son 100% tabulares — el motor (`src/lib/nomina/motor.ts`) solo interpreta la
// `formula`, nunca hardcodea un concepto por nombre. Corte curado (primer incremento, como el CGC
// de Contabilidad): retención en la fuente, PILA, pago de pasivos a terceros y novedades
// (vacaciones/incapacidades afectando el neto) quedan para el siguiente incremento.

enum ConceptoNominaTipo {
  DEVENGADO
  DEDUCCION
  APORTE_PATRONAL
  PRESTACION_SOCIAL
}

enum FormulaConcepto {
  FIJO
  PORCENTAJE_SUELDO
  PORCENTAJE_IBC
  PORCENTAJE_DEVENGADO
  /// Tabla progresiva Art. 383 ET (en UVT) sobre la base gravable — la calcula el motor, no un %.
  RETENCION_FUENTE
  /// 66.67% del salario proporcional a los días de incapacidad desde el día 3 (Ley 100/1993 Art. 227).
  AUXILIO_INCAPACIDAD
}

enum EstadoPeriodoNomina {
  ABIERTO
  LIQUIDADO
  PAGADO
  CERRADO
}

/// Catálogo de conceptos de nómina (devengados/deducciones/aportes/prestaciones), sembrado y
/// editable por tenant — igual patrón que el CGC/CCPET.
model ConceptoNomina {
  id                    String             @id @default(cuid())
  codigo                String             @unique // "NC-001"
  nombre                String
  tipo                  ConceptoNominaTipo
  formula               FormulaConcepto
  porcentaje            Decimal?           @db.Decimal(6, 4)
  valorFijo             Decimal?           @db.Decimal(18, 2)
  /// ¿Cuenta como base para prestaciones/aportes (IBC)? (ej. sueldo sí, auxilio de transporte no).
  constitutivoSalario   Boolean            @default(false)
  /// Código de PlanCuenta (Contabilidad) al que postea este concepto. Null = no postea.
  cuentaContableCodigo  String?
  /// Orden de aplicación dentro de su tipo (devengados → deducciones → aportes/prestaciones).
  orden                 Int                @default(0)
  activo                Boolean            @default(true)

  detalles LiquidacionNominaDetalle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nom_conceptos")
}

/// Periodo de nómina (mensual). Los estados replican el ciclo real: se liquida, se paga, se cierra.
model PeriodoNomina {
  id          String              @id @default(cuid())
  codigo      String              @unique // "2026-05"
  anio        Int
  mes         Int
  estado      EstadoPeriodoNomina @default(ABIERTO)
  fechaInicio DateTime
  fechaFin    DateTime
  liquidadoEn DateTime?
  pagadoEn    DateTime?

  liquidaciones LiquidacionNomina[]
  pilaExports   NominaPilaExport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([anio, mes])
  @@map("nom_periodos")
}

/// Una fila por funcionario liquidado en el periodo (único por periodo+usuario). `salarioBasico`
/// es un snapshot al momento de liquidar (la vinculación puede cambiar después sin afectar el
/// histórico ya liquidado).
model LiquidacionNomina {
  id                     String        @id @default(cuid())
  periodoId              String
  periodo                PeriodoNomina @relation(fields: [periodoId], references: [id])
  usuarioId              String
  usuario                Usuario       @relation(fields: [usuarioId], references: [id])
  salarioBasico          Decimal       @db.Decimal(18, 2)
  totalDevengado         Decimal       @default(0) @db.Decimal(18, 2)
  totalDeducciones       Decimal       @default(0) @db.Decimal(18, 2)
  totalAportesPatronales Decimal       @default(0) @db.Decimal(18, 2)
  netoPagar              Decimal       @default(0) @db.Decimal(18, 2)

  comprobanteId String?
  comprobante   Comprobante? @relation(fields: [comprobanteId], references: [id])

  detalles LiquidacionNominaDetalle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodoId, usuarioId])
  @@index([usuarioId])
  @@index([comprobanteId])
  @@map("nom_liquidaciones")
}

/// Línea de liquidación por concepto aplicado (auditoría: cómo se llegó al total de cada empleado).
model LiquidacionNominaDetalle {
  id            String            @id @default(cuid())
  liquidacionId String
  liquidacion   LiquidacionNomina @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  conceptoId    String
  concepto      ConceptoNomina    @relation(fields: [conceptoId], references: [id])
  valor         Decimal           @db.Decimal(18, 2)
  base          Decimal?          @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([liquidacionId])
  @@map("nom_liquidacion_detalles")
}

/// Parámetros de nómina vigentes del tenant (singleton: una sola fila). El UVT lo publica la DIAN
/// cada año — se siembra con un valor de referencia y el tenant lo actualiza cuando cambie.
model NominaParametro {
  id  String  @id @default(cuid())
  uvt Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nom_parametros")
}

/// Trazabilidad de cada descarga del archivo PILA (auditoría: quién generó qué, cuándo).
model NominaPilaExport {
  id             String        @id @default(cuid())
  periodoId      String
  periodo        PeriodoNomina @relation(fields: [periodoId], references: [id])
  totalEmpleados Int
  generadoPor    String?

  createdAt DateTime @default(now())

  @@index([periodoId])
  @@map("nom_pila_exports")
}

/// Pago a un tercero externo (EPS/AFP/ARL/caja/DIAN) del pasivo que dejó acreditado el pago de
/// nómina — segunda mitad del ciclo (primero se causa el pasivo al pagar la planilla, después se
/// gira a cada entidad). Genera su propio comprobante D pasivo / C banco.
model NominaPagoPasivo {
  id           String       @id @default(cuid())
  cuentaCodigo String
  cuentaNombre String
  tercero      String
  terceroNit   String?
  valor        Decimal      @db.Decimal(18, 2)
  fecha        DateTime
  comprobanteId String?
  comprobante   Comprobante? @relation(fields: [comprobanteId], references: [id])
  observacion  String?
  creadoPor    String?

  createdAt DateTime @default(now())

  @@index([comprobanteId])
  @@map("nom_pagos_pasivos")
}

// ───────────────────── Módulo: TESORERÍA (cuentas + conciliación bancaria) ─────────────────────
// Diferenciador de diseño: Tesorería NO duplica un libro de movimientos aparte. Presupuesto (Pago),
// Nómina (pago de periodo, pago de pasivo) y Contabilidad (comprobante manual) YA generan Asientos
// reales sobre la cuenta bancaria (`Asiento.cuentaId` = `TesoCuenta.cuentaContableId`) — el
// "movimiento de tesorería" es una VISTA derivada de esos Asientos, nunca una segunda captura. Solo
// se agrega una vía de captura para lo que genuinamente no nace en otro módulo (recaudo directo,
// rendimientos financieros, traslados entre cuentas propias) — y esa vía también postea un
// Comprobante real, igual que todo lo demás; nunca queda fuera del libro mayor.

enum TesoCuentaTipo {
  CORRIENTE
  AHORROS
  INVERSION_TEMPORAL
  FONDOS_ESPECIALES
}

/// Cuenta bancaria institucional, ligada a su cuenta contable REAL (no texto libre) — así el saldo
/// de tesorería siempre es el mismo número que el libro mayor, nunca dos verdades distintas.
model TesoCuenta {
  id               String         @id @default(cuid())
  nombre           String
  banco            String
  nitBanco         String?
  numeroCuenta     String
  tipo             TesoCuentaTipo @default(CORRIENTE)
  activa           Boolean        @default(true)
  cuentaContableId String
  cuentaContable   PlanCuenta     @relation(fields: [cuentaContableId], references: [id])

  extractos      TesoExtracto[]
  conciliaciones TesoConciliacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cuentaContableId])
  @@map("teso_cuentas")
}

/// Extracto bancario cargado por periodo (un solo extracto por cuenta+mes).
model TesoExtracto {
  id           String     @id @default(cuid())
  cuentaId     String
  cuenta       TesoCuenta @relation(fields: [cuentaId], references: [id])
  periodo      String // "2026-07"
  saldoInicial Decimal    @db.Decimal(18, 2)
  saldoFinal   Decimal    @db.Decimal(18, 2)
  cargadoPor   String?
  observacion  String?

  lineas TesoExtractoLinea[]

  createdAt DateTime @default(now())

  @@unique([cuentaId, periodo])
  @@index([cuentaId])
  @@map("teso_extractos")
}

/// Línea del extracto (una fila del PDF/CSV que el banco entrega).
model TesoExtractoLinea {
  id          String       @id @default(cuid())
  extractoId  String
  extracto    TesoExtracto @relation(fields: [extractoId], references: [id], onDelete: Cascade)
  fecha       DateTime
  descripcion String
  referencia  String?
  debito      Decimal?     @db.Decimal(18, 2)
  credito     Decimal?     @db.Decimal(18, 2)
  saldo       Decimal?     @db.Decimal(18, 2)

  conciliacionLinea TesoConciliacionLinea?

  createdAt DateTime @default(now())

  @@index([extractoId])
  @@map("teso_extracto_lineas")
}

/// Concilia UN Asiento real (ya contabilizado por el módulo que lo originó) contra 1+ líneas del
/// extracto — nunca crea un movimiento paralelo, apunta al que ya existe en el libro mayor.
model TesoConciliacion {
  id            String     @id @default(cuid())
  cuentaId      String
  cuenta        TesoCuenta @relation(fields: [cuentaId], references: [id])
  asientoId     String     @unique
  asiento       Asiento    @relation(fields: [asientoId], references: [id])
  conciliadoPor String?

  lineas TesoConciliacionLinea[]

  createdAt DateTime @default(now())

  @@index([cuentaId])
  @@map("teso_conciliaciones")
}

/// Une una conciliación con cada línea del extracto que la compone (soporta 1:1 y N:1 — el banco
/// suele desglosar un solo pago en varias líneas, ej. principal + retenciones).
model TesoConciliacionLinea {
  id              String            @id @default(cuid())
  conciliacionId  String
  conciliacion    TesoConciliacion  @relation(fields: [conciliacionId], references: [id], onDelete: Cascade)
  extractoLineaId String            @unique
  extractoLinea   TesoExtractoLinea @relation(fields: [extractoLineaId], references: [id])

  @@index([conciliacionId])
  @@map("teso_conciliacion_lineas")
}

// ───────────────────── Módulo: RENTAS (ingresos tributarios: predial + ICA) ─────────────────────
// Cierra el hueco identificado en la auditoría de Hacienda Pública: Presupuesto solo modelaba la
// cadena del GASTO (CDP→RP→Obligación→Pago); el lado del INGRESO no tenía equivalente. El
// contribuyente REUSA `Tercero` (no se duplica un registro de personas/NIT). Las tarifas (Acuerdo
// Municipal, cambian cada vigencia y varían por entidad) son DATO del tenant, editable — nunca un
// catálogo nacional quemado, a diferencia del CGC/CCPET/DAFP que sí lo son. El pago de una
// liquidación postea un Comprobante INGRESO real (mismas cuentas 410502/410510 que YA existían en
// el CGC) — aparece automático en Tesorería sin captura duplicada, mismo diseño ya verificado ahí.
// Simplificación legal declarada honestamente (no placeholder falso): la liquidación predial no
// aplica el tope de incremento anual (Ley 44/1990 Art. 6) ni descuentos por pronto pago — ambos
// son ajustes sobre el valor ya liquidado correctamente, quedan para un siguiente incremento.

enum RentaTipoImpuesto {
  PREDIAL
  ICA
}

enum RentaDestinoEconomico {
  RESIDENCIAL
  COMERCIAL
  INDUSTRIAL
  RURAL
  LOTE_URBANIZABLE
  INSTITUCIONAL
}

enum RentaEstadoLiquidacion {
  PENDIENTE
  EN_COBRO_COACTIVO
  PAGADA
  ANULADA
}

/// Predio (inmueble) sujeto a impuesto predial. El contribuyente es un `Tercero` (no se duplica).
model RentaPredio {
  id              String                @id @default(cuid())
  numeroPredial   String                @unique // matrícula/ficha catastral
  contribuyenteId String
  contribuyente   Tercero               @relation(fields: [contribuyenteId], references: [id])
  direccion       String
  destino         RentaDestinoEconomico
  avaluoCatastral Decimal               @db.Decimal(18, 2)
  estrato         Int?
  activo          Boolean               @default(true)

  liquidaciones RentaLiquidacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contribuyenteId])
  @@map("renta_predios")
}

/// Catálogo de actividades económicas del tenant (código + tarifa ICA por mil) — dato del tenant,
/// no nacional: cada municipio fija su propia tarifa por Acuerdo dentro de los rangos de ley.
model RentaActividadEconomica {
  id         String  @id @default(cuid())
  codigo     String  @unique
  nombre     String
  tarifaXMil Decimal @db.Decimal(6, 2) // tarifa ICA por mil sobre ingresos brutos declarados
  activa     Boolean @default(true)

  establecimientos RentaEstablecimiento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("renta_actividades_economicas")
}

/// Establecimiento de comercio sujeto a ICA. El contribuyente es un `Tercero` (no se duplica).
model RentaEstablecimiento {
  id              String                  @id @default(cuid())
  contribuyenteId String
  contribuyente   Tercero                 @relation(fields: [contribuyenteId], references: [id])
  actividadId     String
  actividad       RentaActividadEconomica @relation(fields: [actividadId], references: [id])
  nombreComercial String
  direccion       String
  activo          Boolean                 @default(true)

  liquidaciones RentaLiquidacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contribuyenteId])
  @@index([actividadId])
  @@map("renta_establecimientos")
}

/// Tabla tarifaria del predial (Acuerdo Municipal), por vigencia — rango de avalúo × destino.
/// Dato del tenant, editable cada vigencia (nunca hardcodeada).
model RentaTarifaPredial {
  id          String                @id @default(cuid())
  vigencia    Int
  destino     RentaDestinoEconomico
  avaluoDesde Decimal               @db.Decimal(18, 2)
  avaluoHasta Decimal? // null = sin tope superior
  tarifaXMil  Decimal               @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vigencia, destino])
  @@map("renta_tarifas_prediales")
}

/// Contador atómico del consecutivo de liquidación, por tipo de impuesto y vigencia.
model RentaLiquidacionConsecutivo {
  id       String            @id @default(cuid())
  tipo     RentaTipoImpuesto
  vigencia Int
  ultimo   Int               @default(0)

  @@unique([tipo, vigencia])
  @@map("renta_liquidacion_consecutivos")
}

/// Liquidación de un impuesto (predial o ICA) para una vigencia. `rubroIngresoId` es OPCIONAL: si
/// el tenant tiene un rubro CCPET de ingreso con `Apropiacion` (aforo) para esa vigencia, el pago
/// se puede comparar recaudado/aforado — el equivalente del lado INGRESO al CDP del lado GASTO.
model RentaLiquidacion {
  id                String                 @id @default(cuid())
  numero            String                 @unique // "PRE-2026-000001" / "ICA-2026-000001"
  tipo              RentaTipoImpuesto
  vigencia          Int
  predioId          String?
  predio            RentaPredio?           @relation(fields: [predioId], references: [id])
  establecimientoId String?
  establecimiento   RentaEstablecimiento?  @relation(fields: [establecimientoId], references: [id])
  rubroIngresoId    String?
  rubroIngreso      RubroPresupuestal?     @relation(fields: [rubroIngresoId], references: [id])
  baseGravable      Decimal                @db.Decimal(18, 2) // avalúo (predial) o ingresos brutos declarados (ICA)
  tarifaAplicada    Decimal                @db.Decimal(6, 2) // por mil
  valor             Decimal                @db.Decimal(18, 2)
  fechaVencimiento  DateTime
  estado            RentaEstadoLiquidacion @default(PENDIENTE)

  /// Proceso de cobro coactivo que la agrupó (null = aún no entró a cobro coactivo).
  procesoCoactivoId String?
  procesoCoactivo   CoactivoProceso? @relation(fields: [procesoCoactivoId], references: [id])

  pago RentaPago?

  creadoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipo, vigencia])
  @@index([predioId])
  @@index([establecimientoId])
  @@index([rubroIngresoId])
  @@index([procesoCoactivoId])
  @@map("renta_liquidaciones")
}

/// Pago de una liquidación (pago total — mismo criterio ya usado en Presupuesto→Pago y
/// Nómina→pagar). Genera un Comprobante INGRESO real: D banco/caja (11xx) / C ingreso (410502
/// predial o 410510 ICA, ya existentes en el CGC) — cierra el ciclo recaudo↔libro mayor.
model RentaPago {
  id            String           @id @default(cuid())
  numero        String           @unique // "REC-" + numero de la liquidación
  liquidacionId String           @unique
  liquidacion   RentaLiquidacion @relation(fields: [liquidacionId], references: [id])
  valor         Decimal          @db.Decimal(18, 2)
  fecha         DateTime
  medioPago     MedioPago        @default(TRANSFERENCIA)
  comprobanteId String           @unique
  comprobante   Comprobante      @relation(fields: [comprobanteId], references: [id])
  creadoPor     String?

  createdAt DateTime @default(now())

  @@map("renta_pagos")
}

// ───────────────────── Módulo: EVALUACIÓN DEL DESEMPEÑO (EDL) ─────────────────────
// Acuerdo de gestión (compromisos al inicio del periodo) + calificación final (0-100, nivel
// derivado) — el proceso real de carrera administrativa (Decreto 1083/2015). El evaluador de
// referencia es el jefe inmediato del cargo (`Cargo.jefeInmediatoId`, ya existente en la
// fundación de dominio) pero RRHH coordina el proceso y captura el resultado oficial — mismo
// criterio que ya aplica a actos administrativos y ausencias.

enum EvaluacionEstado {
  ACUERDO_ESTABLECIDO
  CALIFICADA
}

enum EvaluacionNivel {
  SOBRESALIENTE
  DESTACADO
  SATISFACTORIO
  NO_SATISFACTORIO
}

model EvaluacionDesempeno {
  id            String           @id @default(cuid())
  usuarioId     String
  usuario       Usuario          @relation("EvaluacionEvaluado", fields: [usuarioId], references: [id])
  evaluadorId   String?
  evaluador     Usuario?         @relation("EvaluacionEvaluador", fields: [evaluadorId], references: [id])
  periodo       String // "2026" o "2026-1"
  fechaInicio   DateTime
  fechaFin      DateTime
  compromisos   String
  estado        EvaluacionEstado @default(ACUERDO_ESTABLECIDO)
  calificacion  Decimal?         @db.Decimal(5, 2)
  nivel         EvaluacionNivel?
  observaciones String?
  fechaCalificacion DateTime?
  creadoPor     String?
  calificadoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, periodo])
  @@index([usuarioId])
  @@map("th_evaluaciones")
}

// ───────────────────── Módulo: SEGURIDAD Y SALUD EN EL TRABAJO (SG-SST) ─────────────────────
// Corte curado (Decreto 1072/2015): matriz de riesgos por cargo, accidentalidad/incidentes,
// exámenes médicos ocupacionales. Simplificación legal declarada honestamente: NO notifica a la
// ARL ni genera el FURAT/FUREL oficial — es un registro interno, no un trámite ante la
// aseguradora.

enum SstNivelRiesgo {
  ACEPTABLE
  MEJORABLE
  NO_ACEPTABLE
}

enum SstTipoIncidente {
  ACCIDENTE
  INCIDENTE
  ENFERMEDAD_LABORAL
}

enum SstTipoExamen {
  INGRESO
  PERIODICO
  RETIRO
}

enum SstResultadoExamen {
  APTO
  APTO_CON_RESTRICCIONES
  NO_APTO
}

model SstRiesgoCargo {
  id             String         @id @default(cuid())
  cargoId        String
  cargo          Cargo          @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  peligro        String
  riesgo         String
  nivelRiesgo    SstNivelRiesgo
  medidasControl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cargoId])
  @@map("sst_riesgos_cargo")
}

model SstIncidente {
  id              String           @id @default(cuid())
  usuarioId       String
  usuario         Usuario          @relation(fields: [usuarioId], references: [id])
  tipo            SstTipoIncidente
  fecha           DateTime
  descripcion     String
  diasIncapacidad Int?
  reportadoArl    Boolean          @default(false)
  creadoPor       String?

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("sst_incidentes")
}

model SstExamenMedico {
  id            String             @id @default(cuid())
  usuarioId     String
  usuario       Usuario            @relation(fields: [usuarioId], references: [id])
  tipo          SstTipoExamen
  fecha         DateTime
  resultado     SstResultadoExamen
  observaciones String?
  creadoPor     String?

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("sst_examenes_medicos")
}

// ───────────────────── Módulo: CAPACITACIÓN (PIC) ─────────────────────
enum CapacitacionTipo {
  CURSO
  DIPLOMADO
  INDUCCION
  REINDUCCION
}

model Capacitacion {
  id                  String            @id @default(cuid())
  nombre              String
  tipo                CapacitacionTipo
  fechaInicio         DateTime
  fechaFin            DateTime
  horas               Int?
  entidadCapacitadora String?
  creadoPor           String?

  inscripciones CapacitacionInscripcion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("th_capacitaciones")
}

model CapacitacionInscripcion {
  id             String       @id @default(cuid())
  capacitacionId String
  capacitacion   Capacitacion @relation(fields: [capacitacionId], references: [id], onDelete: Cascade)
  usuarioId      String
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])
  asistio        Boolean      @default(false)
  certificadoUrl String?

  createdAt DateTime @default(now())

  @@unique([capacitacionId, usuarioId])
  @@index([usuarioId])
  @@map("th_capacitacion_inscripciones")
}

// ───────────────────── Módulo: BIENESTAR SOCIAL ─────────────────────
enum BienestarTipo {
  DEPORTIVA
  CULTURAL
  INTEGRACION
  RECONOCIMIENTO
}

model ActividadBienestar {
  id          String        @id @default(cuid())
  nombre      String
  tipo        BienestarTipo
  fecha       DateTime
  descripcion String?
  creadoPor   String?

  participantes BienestarParticipante[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("th_actividades_bienestar")
}

model BienestarParticipante {
  id          String             @id @default(cuid())
  actividadId String
  actividad   ActividadBienestar @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     Usuario            @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())

  @@unique([actividadId, usuarioId])
  @@index([usuarioId])
  @@map("th_bienestar_participantes")
}

// ───────────────────── Módulo: RELACIONES LABORALES ─────────────────────
model PermisoSindical {
  id          String   @id @default(cuid())
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  fechaInicio DateTime
  fechaFin    DateTime
  motivo      String
  creadoPor   String?

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("th_permisos_sindicales")
}

// ───────────────────── Módulo: GESTIÓN DISCIPLINARIA ─────────────────────
// Historial de actuaciones insert-only (mismo patrón que CoactivoActuacion/ProyectoHitoReporte).
// Simplificación legal declarada honestamente: es un registro administrativo del trámite interno
// (Ley 1952/2019, Código General Disciplinario), no un sistema de notificación judicial con
// efectos procesales garantizados (términos de ejecutoria, edictos).

enum DisciplinarioEstado {
  INDAGACION_PRELIMINAR
  INVESTIGACION
  DESCARGOS
  FALLO
  ARCHIVADO
}

/// Contador atómico del consecutivo de procesos disciplinarios, por año.
model DisciplinarioConsecutivo {
  id     String @id @default(cuid())
  anio   Int    @unique
  ultimo Int    @default(0)

  @@map("th_disciplinario_consecutivos")
}

model ProcesoDisciplinario {
  id            String              @id @default(cuid())
  numero        String              @unique // "DISC-2026-000001"
  usuarioId     String
  usuario       Usuario             @relation(fields: [usuarioId], references: [id])
  motivo        String
  fechaApertura DateTime
  estado        DisciplinarioEstado @default(INDAGACION_PRELIMINAR)
  decision      String?
  fechaFallo    DateTime?
  creadoPor     String?

  actuaciones DisciplinarioActuacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@map("th_procesos_disciplinarios")
}

model DisciplinarioActuacion {
  id            String               @id @default(cuid())
  procesoId     String
  proceso       ProcesoDisciplinario @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  fecha         DateTime
  descripcion   String
  registradoPor String?

  createdAt DateTime @default(now())

  @@index([procesoId])
  @@map("th_disciplinario_actuaciones")
}

// ───────────────────── Módulo: COBRO COACTIVO (Ley 1066/2006, Art. 823+ ET) ─────────────────────
// Agrupa las liquidaciones de Rentas VENCIDAS de un mismo contribuyente+tipo de impuesto en un
// expediente único (`CoactivoProceso`) — refleja cómo se cobra en la práctica: por deudor, no por
// factura suelta. `CoactivoActuacion` es un historial insert-only (auditoría ante entes de
// control, mismo patrón que `ProyectoHitoReporte`). El acuerdo de pago en cuotas es la única vía
// de pago parcial de este módulo; una vez pagada la última cuota (o pagado el total antes de
// entrar a un acuerdo), el proceso TERMINA y las liquidaciones agrupadas pasan a PAGADA en bloque.
// Cada cuota/pago total postea un Comprobante INGRESO real — mismo diseño de "cero duplicación"
// que Rentas y Tesorería.
//
// Simplificación legal declarada honestamente (no placeholder falso): NO calcula intereses de
// mora (Art. 634-635 ET) sobre la deuda, y `CoactivoActuacion` es un registro administrativo del
// trámite, no un sistema de notificación judicial con efectos procesales (edictos, términos de
// ejecutoria) — eso excede lo que este corte puede garantizar sin asesoría jurídica específica.

enum CoactivoEstado {
  PERSUASIVO // cobro persuasivo previo, antes del mandamiento de pago formal
  MANDAMIENTO_PAGO
  EMBARGO // medida cautelar decretada
  ACUERDO_PAGO
  TERMINADO
}

enum CoactivoTipoActuacion {
  COBRO_PERSUASIVO
  MANDAMIENTO_PAGO
  MEDIDA_CAUTELAR
  ACUERDO_PAGO
  PAGO
  TERMINACION
  OTRA
}

enum CoactivoEstadoCuota {
  PENDIENTE
  PAGADA
}

/// Contador atómico del consecutivo de proceso de cobro coactivo, por vigencia.
model CoactivoConsecutivo {
  id       String @id @default(cuid())
  vigencia Int    @unique
  ultimo   Int    @default(0)

  @@map("coa_consecutivos")
}

/// Expediente de cobro coactivo: agrupa la cartera VENCIDA de un contribuyente para UN tipo de
/// impuesto (predial o ICA, nunca mezclados — mantiene la contabilización determinística: cada
/// proceso postea siempre a la misma cuenta de ingreso 410502/410510).
model CoactivoProceso {
  id              String         @id @default(cuid())
  numero          String         @unique // "COA-2026-000001"
  vigencia        Int
  contribuyenteId String
  contribuyente   Tercero        @relation(fields: [contribuyenteId], references: [id])
  tipo            RentaTipoImpuesto
  estado          CoactivoEstado @default(PERSUASIVO)
  /// Snapshot de la deuda al abrir el proceso — suma de las liquidaciones agrupadas.
  valorInicial    Decimal        @db.Decimal(18, 2)
  fechaApertura   DateTime
  creadoPor       String?

  liquidaciones RentaLiquidacion[]
  actuaciones   CoactivoActuacion[]
  acuerdoPago   CoactivoAcuerdoPago?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contribuyenteId])
  @@index([tipo, vigencia])
  @@map("coa_procesos")
}

/// Historial insert-only del trámite — auditoría ante entes de control (Contraloría/Procuraduría).
model CoactivoActuacion {
  id          String                @id @default(cuid())
  procesoId   String
  proceso     CoactivoProceso       @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  tipo        CoactivoTipoActuacion
  fecha       DateTime
  descripcion String
  registradoPor String?

  createdAt DateTime @default(now())

  @@index([procesoId])
  @@map("coa_actuaciones")
}

/// Acuerdo de pago en cuotas — única forma de pago PARCIAL de la deuda coactiva. Una vez creado,
/// el proceso pasa a estado ACUERDO_PAGO; termina cuando se paga la última cuota.
model CoactivoAcuerdoPago {
  id                String          @id @default(cuid())
  procesoId         String          @unique
  proceso           CoactivoProceso @relation(fields: [procesoId], references: [id])
  numeroCuotas      Int
  valorCuota        Decimal         @db.Decimal(18, 2)
  fechaPrimeraCuota DateTime

  cuotas CoactivoCuota[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coa_acuerdos_pago")
}

/// Cuota individual del acuerdo. Al pagarse postea un Comprobante INGRESO real (mismo criterio
/// que `RentaPago`: D banco/caja / C cuenta de ingreso del tipo de impuesto del proceso).
model CoactivoCuota {
  id            String              @id @default(cuid())
  acuerdoId     String
  acuerdo       CoactivoAcuerdoPago @relation(fields: [acuerdoId], references: [id], onDelete: Cascade)
  numero        Int
  fechaVencimiento DateTime
  valor         Decimal             @db.Decimal(18, 2)
  estado        CoactivoEstadoCuota @default(PENDIENTE)
  comprobanteId String?             @unique
  comprobante   Comprobante?        @relation(fields: [comprobanteId], references: [id])
  creadoPor     String?

  createdAt DateTime @default(now())

  @@unique([acuerdoId, numero])
  @@index([acuerdoId])
  @@map("coa_cuotas")
}
